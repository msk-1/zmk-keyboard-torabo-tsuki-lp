/*
 * torabo-tsuki LP キーマップ設定 (zmk-config-roBa 移植版)
 * - レイヤー定義 (0:default 1:ARROW_FN 2:SYMBOL 3:NUM_FN 4:MOUSE 5:SCROLL 6:BLUETOOTH 7:ALT_LAYER)
 * - コンボ
 * - マクロ
 */

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    tapping-term-ms = <180>;
};

&caps_word { continue-list = <UNDERSCORE MINUS BACKSPACE DELETE SPACE>; };

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>; // D+F
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <16 17>; // J+K
        };

        tilde {
            bindings = <&kp GRAVE>;
            key-positions = <6 7>; // U+I
        };

        bq {
            bindings = <&kp BACKSLASH>;
            key-positions = <28 29>; // M+,
        };

        layout_shift_on {
            bindings = <&tog_ls_on>;
            key-positions = <9 19>; // P+-
        };

        layout_shift_off {
            bindings = <&tog_ls_off>;
            key-positions = <19 31>; // -+/
        };
    };

    macros {
        m_c_pgup: m_c_pgup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp PAGE_UP>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        m_c_pgdn: m_c_pgdn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp PAGE_DOWN>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        // Layer-mod: holds LALT + activates specified layer

        lm: lm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT &macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    behaviors {
        // 電池残量をLEDの点滅回数(1〜5回)で表示する
        // 注意: splitで両手に届くようノード名は8文字以内にすること

        bat_led: bat_led {
            compatible = "zmk,behavior-battery-led";
            #binding-cells = <0>;
            led = <&status_led>;
            blink-ms = <150>;
            pause-ms = <250>;
        };

        // Keep the original key_press behavior for ZMK core components

        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        // Override &kp for layout shift (Keymap Editor compatible)

        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };

        tog_ls_on: toggle_layout_shift_on {
            compatible = "zmk,behavior-layout-shift-toggle";
            #binding-cells = <0>;
            toggle-mode = "on";
            label = "LAYOUT_SHIFT_TOGGLE_ON";
        };

        tog_ls_off: toggle_layout_shift_off {
            compatible = "zmk,behavior-layout-shift-toggle";
            #binding-cells = <0>;
            toggle-mode = "off";
            label = "LAYOUT_SHIFT_TOGGLE_OFF";
        };

        // Hold: ALT + layer, Tap: key

        alt_lt: alt_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "ALT_LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            bindings = <&lm>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W          &kp E             &kp R               &kp T                                           &kp Y        &kp U  &kp I      &kp O    &lt 5 P
&mt LCTRL A       &kp S          &kp D             &mt LEFT_CONTROL F  &kp G                                           &kp H        &kp J  &kp K      &kp L    &lt 1 MINUS
&mt LEFT_SHIFT Z  &kp X          &kp C             &kp V               &kp B        &kp TAB             &bat_led       &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LC(LS(N4))    &kp LG(LS(S))  &kp LEFT_COMMAND  &alt_lt 7 LANG2     &lt 2 SPACE  &mt LEFT_WIN LANG1  &kp BACKSPACE  &lt 3 ENTER  &none  &none      &none    &lt 6 ESCAPE
            >;
        };

        ARROW_FN {
            bindings = <
&kp F1            &kp F2              &kp F3     &kp F4     &kp F5                   &kp F6            &kp F7          &kp F8        &kp F9           &none
&kp LEFT_CONTROL  &kp LC(LEFT_SHIFT)  &kp F10    &kp F11    &kp F12                  &kp LEFT_ARROW    &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none
&kp LEFT_SHIFT    &kp LEFT_GUI        &m_c_pgup  &m_c_pgdn  &none    &none   &none   &kp RG(UP_ARROW)  &kp HOME        &kp END       &none            &none
&trans            &trans              &trans     &trans     &trans   &trans  &trans  &trans            &none           &none         &none            &none
            >;
        };

        SYMBOL {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                   &kp CARET         &kp AMPERSAND         &kp ASTERISK           &kp EQUAL         &kp BACKSLASH
&kp ESC          &none        &none     &none       &none                         &kp SEMICOLON     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp LEFT_SHIFT   &none        &none     &none       &none        &none   &none    &kp SINGLE_QUOTE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN     &kp GREATER_THAN
&none            &none        &none     &trans      &trans       &trans  &kp DEL  &trans            &none                 &none                  &none             &none
            >;
        };

        NUM_FN {
            bindings = <
&kp N1            &kp N2            &kp N3            &kp N4            &kp N5                                 &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&trans            &trans            &trans            &trans            &trans                                 &trans  &trans  &trans  &trans  &trans
&kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &kp LC(NUMBER_4)  &kp LS(ESCAPE)  &trans  &trans         &trans  &trans  &trans  &trans  &trans
&trans            &trans            &trans            &trans            &trans          &trans  &kp BACKSPACE  &trans  &trans  &none   &none   &none
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &none     &none     &none
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &none
            >;
        };

        BLUETOOTH {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans                       &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
&trans  &trans  &trans  &trans  &trans  &trans  &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans        &trans        &none         &none         &none
            >;
        };

        ALT_LAYER {
            bindings = <
&trans   &trans       &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
&kp ESC  &kp TAB      &trans  &trans  &trans                     &trans  &trans  &trans  &trans  &trans
&trans   &kp LS(TAB)  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
&trans   &trans       &trans  &trans  &trans  &trans  &kp SPACE  &trans  &trans  &none   &none   &none
            >;
        };
    };
};
